<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style Selector="suki|CircleProgressBar">
		<Setter Property="ArcBackground" Value="{DynamicResource SukiLightBorderBrush}" />
		<Setter Property="ArcForeground" Value="{DynamicResource SukiPrimaryColor}" />
	</Style>
</Styles>
